<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_slot_border"
    android:orientation="vertical">

    <!-- Header / Control bar for this slot -->
    <LinearLayout
        android:id="@+id/layoutSlotHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSlotTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ngăn 1"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btnSlotBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="6dp"
            android:src="@drawable/ic_back" />

        <!-- Refresh button -->
        <ImageButton
            android:id="@+id/btnSlotRefresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tải lại"
            android:padding="6dp"
            android:src="@drawable/ic_refresh" />

        <!-- Mute / Unmute button -->
        <ImageButton
            android:id="@+id/btnSlotMute"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bật/Tắt âm thanh"
            android:padding="6dp"
            android:src="@drawable/ic_volume_up" />

        <!-- Choose app / Enter link button -->
        <ImageButton
            android:id="@+id/btnSlotChangeApp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đổi ứng dụng"
            android:padding="6dp"
            android:src="@drawable/ic_apps" />

        <!-- Maximize / Restore slot button -->
        <ImageButton
            android:id="@+id/btnSlotMaximize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Phóng to"
            android:padding="6dp"
            android:src="@drawable/ic_expand" />
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/slotProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:visibility="gone" />

    <!-- WebView Container -->
    <FrameLayout
        android:id="@+id/slotWebViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
